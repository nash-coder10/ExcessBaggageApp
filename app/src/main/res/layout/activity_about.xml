<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@drawable/bluegradient">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="About Developer"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Name: Nurul Nasuha binti Suhainizam&#10;Student No: 2024648656&#10;Group: RCDCS2515A&#10;Programme Code: CS251"
        android:textSize="16sp"
        android:lineSpacingExtra="8dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="© 2026 Nurul Nasuha. All rights reserved."
        android:textSize="14sp"
        android:textStyle="italic"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/txtGithubUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GitHub Repository: https://github.com/nash-coder10/ExcessBaggageApp.git"
        android:textSize="15sp"
        android:textColor="#1E88E5"
        android:autoLink="web"
        android:clickable="true"
        android:focusable="true"/>
    <!-- Back Button -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Calculator"
        android:backgroundTint="#1E88E5"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp"/>

</LinearLayout>